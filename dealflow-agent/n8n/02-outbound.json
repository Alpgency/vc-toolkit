      "name": "Every 20s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Polls Twenty for deals in Reach out and dedupes via workflow static data. A Twenty webhook could replace the poll."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "dsn",
              "value": "YOUR_UNIPILE_DSN",
              "type": "string"
            },
            {
              "id": "a2",
