              "type": "string"
            },
            {
              "id": "a5",
              "name": "sender_name",
              "value": "YOUR_NAME",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "d2151eec-7da2-493a-a116-53ece3baa977",
      "name": "Config (EDIT ME)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://twenty-server:3000/rest/opportunities?filter=stage[eq]:REACH_OUT&limit=60",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "8ceca9c5-5759-4b2e-94ac-e80b2c85ac7e",
      "name": "Twenty · list opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        400,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nsd.processed = sd.processed || [];\nconst body = $input.first().json;\nconst opps = (body.data && (body.data.opportunities || Object.values(body.data)[0])) || [];\nfor (const o of opps) {\n  if (o.stage !== 'REACH_OUT') continue;\n  if (sd.processed.includes(o.id)) continue;\n  if (!o.companyId || !o.pointOfContactId) continue;\n  sd.processed.push(o.id);\n  return [{ json: {\n    dealId: o.id,\n    dealName: o.name || 'Deal',\n    companyId: o.companyId,\n    personId: o.pointOfContactId,\n    tags: o.tags || '',\n    oneLiner: o.oneLiner || '',\n  } }];\n}\nreturn [];"
      },
      "id": "3a60eb1e-16a2-4759-a390-be305e48c2e1",
      "name": "Pick next Reach out deal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://twenty-server:3000/rest/people/{{ $json.personId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "e34105a1-4497-4768-8b41-25b4fe4a0733",
      "name": "Twenty · get founder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        800,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://twenty-server:3000/rest/companies/{{ $('Pick next Reach out deal').item.json.companyId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "c13b743f-1fda-4579-978c-ff7b589bf1e4",
      "name": "Twenty · get company",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1000,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const pick = $('Pick next Reach out deal').first().json;\nconst pBody = $('Twenty · get founder').first().json;\nconst person = (pBody.data && (pBody.data.person || Object.values(pBody.data)[0])) || {};\nconst cBody = $('Twenty · get company').first().json;\nconst company = (cBody.data && (cBody.data.company || Object.values(cBody.data)[0])) || {};\nconst cfg = $('Config (EDIT ME)').first().json;\nconst nameVal = person.name || {};\nconst first = nameVal.firstName || 'there';\nconst full = ((nameVal.firstName || '') + ' ' + (nameVal.lastName || '')).trim() || first;\nlet linkedinUrl = (person.linkedinLink && person.linkedinLink.primaryLinkUrl) || null;\nlet foundVia = 'record';\nlet searchNote = '';\nif (!linkedinUrl) {\n  try {\n    const sr = $('Unipile · search founder').first().json;\n    const items = (sr.items || []).filter(i => (i.type || '').toUpperCase() === 'PEOPLE');\n    if (items.length) {\n      const hit = items[0];\n      linkedinUrl = hit.profile_url || (hit.public_identifier ? 'https://www.linkedin.com/in/' + hit.public_identifier + '/' : null);\n      foundVia = 'linkedin_search';\n      searchNote = '\\nFound via live LinkedIn search: ' + (hit.headline || 'no headline') + (hit.network_distance ? ' (' + hit.network_distance + ')' : '');\n    }\n  } catch (e) {}\n}\nconst compName = company.name || pick.dealName.split(' (')[0];\nconst tags = String(pick.tags || '').split(',');\n// Variant rules: referred -> warm_intro; stealth -> stealth; hot -> high_profile; else active.\nconst variant = tags.includes('referred') ? 'warm_intro' : tags.includes('stealth') ? 'stealth' : tags.includes('hot') ? 'high_profile' : 'active';\nconst obs = pick.oneLiner || 'what you are building';\nconst mutual = 'A mutual contact';\n// EDIT ME: outreach copy mirrors config/sequences.json. Placeholders: {f} founder first name,\n// {c} company, {b} booking link, {obs} observation (filled from the CRM one-liner),\n// {mutual} introducer, {fund} and {sender} from the Config node.\nconst SEQ = {\n  \"en_stealth\": [\n    \"Hi {f},\\n\\nI heard you are starting something new and would like to learn more when you are ready to share.\\n\\nQuick context: I work at {fund}, an early-stage fund investing in B2B software, fintech infrastructure and developer tools, with first tickets of 250k to 1M EUR.\\n\\nOpen to a short chat?\\n\\nBest,\\n{sender}\",\n    \"Hi {f},\\n\\nFollowing up on my note. If a conversation makes sense, you can pick a time here: {b}\\n\\nBest,\\n{sender}\"\n  ],\n  \"en_active\": [\n    \"Hi {f},\\n\\nI have been following {c}. This caught my attention: {obs}\\n\\nAt {fund} we back pre-seed and seed teams in B2B software. I would like to understand what you are building and what you are focused on right now.\\n\\nWould you have 20 minutes?\\n\\nBest,\\n{sender}\",\n    \"Hi {f},\\n\\nFollowing up on my note. If a conversation makes sense, you can pick a time here: {b}\\n\\nBest,\\n{sender}\"\n  ],\n  \"en_high_profile\": [\n    \"Hi {f},\\n\\nI have been following what you are building at {c}. This stood out: {obs}\\n\\nAt {fund} we invest early and decide quickly when we have conviction. If you are open to it, you can book 20 to 30 minutes here: {b}\\n\\nBest,\\n{sender}\",\n    \"Hi {f},\\n\\nWanted to follow up. {c} keeps coming up on our side and I would still like to talk.\\n\\nIf you have 20 minutes in the coming weeks: {b}\\n\\nBest,\\n{sender}\"\n  ],\n  \"en_warm_intro\": [\n    \"Hi {f},\\n\\n{mutual} suggested I reach out about {c}.\\n\\nI took a closer look and this stood out: {obs}\\n\\nAt {fund} we back early-stage B2B software teams. Happy to find a time that works for you.\\n\\nBest,\\n{sender}\",\n    \"Hi {f},\\n\\nFollowing up on my note. If a conversation makes sense, you can pick a time here: {b}\\n\\nBest,\\n{sender}\"\n  ]\n};\n// Language comes from the first tag (set at intake). Falls back to English when no copy exists for it.\nconst lang = /^[a-z]{2}$/.test(tags[0]) ? tags[0] : 'en';\nconst key = SEQ[lang + '_' + variant] ? lang + '_' + variant : 'en_' + variant;\nconst fill = (s) => s.split('{f}').join(first).split('{c}').join(compName).split('{b}').join(cfg.booking_link).split('{obs}').join(obs).split('{mutual}').join(mutual).split('{fund}').join(cfg.fund_name).split('{sender}').join(cfg.sender_name);\nconst msg1 = fill(SEQ[key][0]);\nconst msg2 = fill(SEQ[key][1]);\nlet handle = null;\nif (linkedinUrl && linkedinUrl.includes('/in/')) handle = linkedinUrl.split('/in/')[1].split(/[/?#]/)[0];\nconst confirmText = 'Ready to start outreach for ' + compName + '\\n\\nFounder: ' + full + '\\nLinkedIn: ' + (linkedinUrl || 'NOT FOUND, will abort') + searchNote + '\\nSequence variant: ' + key + '\\n\\nMessage 1:\\n' + msg1 + '\\n\\nFollow-up (sent after the Wait node delay if no reply):\\n' + msg2;\nreturn [{ json: { ...pick, first, full, compName, linkedinUrl, handle, foundVia, key, msg1, msg2, confirmText } }];\n"
      },
      "id": "e4cf7a93-a18d-42e5-b631-8565fc51fc6b",
      "name": "Build variant + confirm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "message": "={{ $json.confirmText }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "buttonApprovalLabel": "Yes, start outreach",
            "buttonDisapprovalLabel": "No, skip"
          }
        },
        "options": {
          "limitWaitTime": true,
          "resumeAmount": 45,
          "resumeUnit": "minutes"
        }
      },
      "id": "ea978fd1-c04e-4cbf-9c9c-8e6da7f270a4",
