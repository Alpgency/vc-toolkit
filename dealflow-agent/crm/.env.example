# Copy to .env next to docker-compose.yml. Never commit the real file.
TAG=latest
# Public URL of the board UI (behind your reverse proxy)
SERVER_URL=https://crm.your-domain.example
TWENTY_PORT=3000
# Name of the Docker network your n8n container runs on
N8N_NETWORK=n8n_default
# openssl rand -hex 24
PG_PASSWORD=
# openssl rand -base64 32
ENCRYPTION_KEY=
